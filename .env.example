# =============================================================================
# 통합 env 예시 — local / dev / prod 어느 프로파일에서도 사용 가능
# 프로파일별로 실제로 참조되는 변수는 아래 주석의 [사용 프로파일] 표시 참고
# 값은 각 환경에 맞게 채워 사용
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# [dev, prod] — local 은 application-local.yml 에 하드코딩
# -----------------------------------------------------------------------------
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Redis
# [dev, prod] — local 은 application-local.yml 에 하드코딩
# -----------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# CORS / OAuth 리다이렉트
# [dev, prod] — 콤마 구분 다중 도메인 가능
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=
OAUTH_REDIRECT_BASE_URL=

# -----------------------------------------------------------------------------
# 보안: 대칭 암호화 (세션/토큰 등)
# [공통(application.yml), dev, prod]
# openssl rand -hex 32  → 64자 hex (32byte)
# openssl rand -hex 16  → 32자 hex (16byte)
# -----------------------------------------------------------------------------
MOONGCHEAP_ENC_PASSWORD=
MOONGCHEAP_ENC_SALT=

# -----------------------------------------------------------------------------
# 내부 API 인증 키 (배치/서비스 간 호출용)
# [공통(application.yml)]
# -----------------------------------------------------------------------------
MOONGCHEAP_INTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# OAuth: Kakao
# [local, dev, prod]
# Kakao Developers → 내 애플리케이션 → 앱 키 → REST API 키
# -----------------------------------------------------------------------------
KAKAO_CLIENT_ID=
# Kakao Developers → 내 애플리케이션 → 제품 설정 → 카카오 로그인 → 보안 → Client Secret
KAKAO_CLIENT_SECRET=
# Kakao Developers → 내 애플리케이션 → 앱 키 → 어드민 키 (회원 탈퇴 시 카카오 연결 해제용)
# [local 만 참조]
KAKAO_ADMIN_KEY=

# -----------------------------------------------------------------------------
# OAuth: Google
# [local, dev, prod]
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Toss Payments BrandPay
# 클라이언트 키는 브라우저 SDK 초기화에 사용하며, 시크릿/보안 키는 서버 밖으로 노출하지 않습니다.
TOSS_BRANDPAY_CLIENT_KEY=
TOSS_BRANDPAY_SECRET_KEY=
TOSS_BRANDPAY_SECURITY_KEY=

# 결제 부하테스트: 설정 변경 후 재배포. 기본은 기존 Toss 경로입니다.
# mock은 앱 내부 sleep/메모리 승인 구현체이며 결제수단 등록·인증 API는 대체하지 않습니다.
PAYMENT_GATEWAY_MODE=toss
PAYMENT_MOCK_DELAY=300ms
PAYMENT_QUEUE_ENABLED=false
# queue를 켠 상태에서도 예약/Outbox 발행을 유지하고 Worker 획득만 끌 수 있습니다.
PAYMENT_WORKER_ENABLED=true
LOAD_TEST_ENABLED=false
