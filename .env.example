# Kakao Developers → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_CLIENT_ID=
# Kakao Developers → 내 애플리케이션 → 제품 설정 → 카카오 로그인 → 보안 → Client Secret
KAKAO_CLIENT_SECRET=
# Kakao Developers → 내 애플리케이션 → 앱 키 → 어드민 키 (회원 탈퇴 시 카카오 연결 해제용)
KAKAO_ADMIN_KEY=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Toss Payments BrandPay
# 클라이언트 키는 브라우저 SDK 초기화에 사용하며, 시크릿/보안 키는 서버 밖으로 노출하지 않습니다.
TOSS_BRANDPAY_CLIENT_KEY=
TOSS_BRANDPAY_SECRET_KEY=
TOSS_BRANDPAY_SECURITY_KEY=
