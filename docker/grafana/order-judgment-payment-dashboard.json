    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "서비스 메서드 호출 / 초",
      "description": "Spring 프록시를 거친 @Service public 메서드. 하위 호출/대기시간 포함; 중첩 서비스 시간을 합산하지 않습니다. returned는 정상 반환이며 업무 성공 여부와 다릅니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 88,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,method,outcome) (rate(moongcheap_service_execution_seconds_count{job=~\"$job\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service}}.{{method}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "서비스 메서드 평균 수행시간",
      "description": "Spring 프록시를 거친 @Service public 메서드. 하위 호출/대기시간 포함; 중첩 서비스 시간을 합산하지 않습니다. returned는 정상 반환이며 업무 성공 여부와 다릅니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 96,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,method,outcome) (rate(moongcheap_service_execution_seconds_sum{job=~\"$job\",service=~\"${service:regex}\"}[$__rate_interval])) / sum by(service,method,outcome) (rate(moongcheap_service_execution_seconds_count{job=~\"$job\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service}}.{{method}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
