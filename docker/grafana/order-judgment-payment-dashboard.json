      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 88,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - moongcheap_collector_last_success_timestamp_seconds{job=~\"$job\"}",
          "legendFormat": "{{instance}} {{source}}"
        }
      ],
