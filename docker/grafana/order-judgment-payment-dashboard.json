{
  "title": "MoongCheap 주문·판정·결제 부하 테스트",
  "uid": "moongcheap-load-test",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "moongcheap-prometheus"
        },
        "refresh": 1
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up, job)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "moongcheap-backend",
          "value": "moongcheap-backend"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(moongcheap_service_execution_seconds_count{job=~\"$job\"}, service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "커밋 완료 처리량 / 초",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(stage,outcome) (rate(moongcheap_completed_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{stage}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "작업 호출 p95 (커밋/롤백 포함)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,operation) (rate(moongcheap_operation_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "완료 지연 p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,stage,outcome) (rate(moongcheap_completion_delay_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{stage}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "완료 지연 p99",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99,sum by(le,stage,outcome) (rate(moongcheap_completion_delay_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{stage}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "최근 완료 지연 최대",
      "description": "Micrometer rolling max. 전체 실행 최대값은 보고서 쿼리 참고.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(stage,outcome) (moongcheap_completion_delay_seconds_max{job=~\"$job\"})",
          "legendFormat": "{{stage}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbox 미발행 이벤트",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(type) (moongcheap_outbox_pending{job=~\"$job\"} and on(job,instance) (moongcheap_collector_up{job=~\"$job\",source=\"outbox\"} == 1) and on(job,instance) (time() - moongcheap_collector_last_success_timestamp_seconds{job=~\"$job\",source=\"outbox\"} < 60))",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox 최장 대기",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(type) (moongcheap_outbox_oldest_seconds{job=~\"$job\"} and on(job,instance) (moongcheap_collector_up{job=~\"$job\",source=\"outbox\"} == 1) and on(job,instance) (time() - moongcheap_collector_last_success_timestamp_seconds{job=~\"$job\",source=\"outbox\"} < 60))",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "결제 DB 상태별 적체",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(state) (moongcheap_payment_backlog{job=~\"$job\"} and on(job,instance) (moongcheap_collector_up{job=~\"$job\",source=\"payments\"} == 1) and on(job,instance) (time() - moongcheap_collector_last_success_timestamp_seconds{job=~\"$job\",source=\"payments\"} < 60))",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "judgment 예약 due",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max (moongcheap_queue_due{job=~\"$job\",queue=\"judgment\"} and on(job,instance) (moongcheap_collector_up{job=~\"$job\",source=\"judgment_queue\"} == 1) and on(job,instance) (time() - moongcheap_collector_last_success_timestamp_seconds{job=~\"$job\",source=\"judgment_queue\"} < 60))",
          "legendFormat": "judgment"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "payment 예약 due",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max (moongcheap_queue_due{job=~\"$job\",queue=\"payment\"} and on(job,instance) (moongcheap_collector_up{job=~\"$job\",source=\"payment_queue\"} == 1) and on(job,instance) (time() - moongcheap_collector_last_success_timestamp_seconds{job=~\"$job\",source=\"payment_queue\"} < 60))",
          "legendFormat": "payment"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "주문 Stream lag / pending",
      "description": "이벤트 단위이며 주문 수와 다릅니다. lag 미지원/그룹 미생성은 결측으로 표시합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(state) (moongcheap_stream_messages{job=~\"$job\"} and on(job,instance) (moongcheap_collector_up{job=~\"$job\",source=\"order_stream\"} == 1) and on(job,instance) (time() - moongcheap_collector_last_success_timestamp_seconds{job=~\"$job\",source=\"order_stream\"} < 60))",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "PG 호출 / 초 (신규 승인 수 아님)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(operation,outcome) (rate(moongcheap_pg_request_seconds_count{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "PG 호출 p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,operation) (rate(moongcheap_pg_request_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Worker 실행 중",
      "description": "claim 조회부터 DB 완료 처리까지의 runOne 점유. 순간 gauge이므로 짧은 작업은 scrape 사이에 끝날 수 있습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "moongcheap_worker_active{job=~\"$job\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Worker 평균 점유 수",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance) (rate(moongcheap_operation_seconds_sum{job=~\"$job\",operation=\"runOne\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Hikari 연결 사용 / 대기",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"hikaricp_connections_active|hikaricp_connections_pending\",job=~\"$job\"}",
          "legendFormat": "{{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "앱 CPU",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{job=~\"$job\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "JVM heap",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance) (jvm_memory_used_bytes{job=~\"$job\",area=\"heap\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "GC 소요시간 / 초",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance) (rate(jvm_gc_pause_seconds_sum{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "PostgreSQL active / lock wait",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(state) (moongcheap_postgres_connections{job=~\"$job\"} and on(job,instance) (moongcheap_collector_up{job=~\"$job\",source=\"postgres\"} == 1) and on(job,instance) (time() - moongcheap_collector_last_success_timestamp_seconds{job=~\"$job\",source=\"postgres\"} < 60))",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "PostgreSQL 최장 트랜잭션",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max (moongcheap_postgres_oldest_transaction_seconds{job=~\"$job\"} and on(job,instance) (moongcheap_collector_up{job=~\"$job\",source=\"postgres\"} == 1) and on(job,instance) (time() - moongcheap_collector_last_success_timestamp_seconds{job=~\"$job\",source=\"postgres\"} < 60))",
          "legendFormat": "database"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "수집 성공 여부 (0: 실패/미지원)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "moongcheap_collector_up{job=~\"$job\"}",
          "legendFormat": "{{instance}} {{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
